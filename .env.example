# URL da API FastAPI que grava os leads no PostgreSQL (POST /leads).
# Se vazio, o formulário apenas abre o WhatsApp sem salvar o lead.
API_URL=

# ID do Google Tag Manager (GTM-XXXXXXX). Vazio: nenhum script de análise é carregado.
NEXT_PUBLIC_GTM_ID=

# URL pública do site (canonical, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.mercalq.com.br

# URL final do site (canonical, sitemap e dados estruturados). Sem isso, usa o domínio padrão.
# NEXT_PUBLIC_SITE_URL=https://www.mercalq.com.br
# Código de verificação do Google Search Console (método "tag HTML", só o valor de content)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Validação com o cliente: 1 bloqueia a indexação no Google. Remover ao publicar no domínio final.
# NEXT_PUBLIC_NOINDEX=1
